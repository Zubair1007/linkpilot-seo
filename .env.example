# ==============================================================================
# LinkPilot SEO — Production & Free-Tier Configuration Template
# NOTE: Never commit sensitive keys or actual database passwords to Git!
# ==============================================================================

# Application Identity & Mode
APP_NAME="LinkPilot SEO"
APP_ENV=production
APP_KEY=base64:GENERATE_VIA_PHP_ARTISAN_KEY_GENERATE_OR_RENDER
APP_DEBUG=false
APP_URL=https://linkpilot-seo.onrender.com
APP_VERSION=1.0.0

# Logging (stderr is recommended for Render / Docker cloud logs)
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Database Connection (Supabase PostgreSQL Free Tier)
# In Supabase: Project Settings -> Database -> Connection Parameters
DB_CONNECTION=pgsql
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.your_supabase_ref
DB_PASSWORD=your_supabase_database_password
DB_SSLMODE=require

# Queue & State (Zero-Budget: Database driver, No Redis required)
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database

# Mailer (Use log or free Resend / Mailgun / Brevo SMTP)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="alerts@linkpilot.io"
MAIL_FROM_NAME="${APP_NAME}"

# Docker & Deployment Automation Flags
RUN_MIGRATIONS=true
RUN_SEEDER=true
RUN_QUEUE_WORKER=true

# Free-Tier Conservative Guardrail Limits
# These limits ensure reliable operation within Render's 512MB RAM and Supabase connection pools
MAX_URLS_PER_IMPORT=50
MAX_URL_CHECKS_PER_RUN=25
MAX_RETRIES=3
REQUEST_TIMEOUT=10
MAX_RESPONSE_SIZE=2097152
MAX_CONCURRENT_CHECKS=3
DAILY_PROVIDER_LIMIT=100

# Optional Third-Party SEO Provider API Credentials
# Leave empty to utilize built-in authority calibration algorithms
MOZ_ACCESS_ID=
MOZ_SECRET_KEY=
AHREFS_API_KEY=
SEMRUSH_API_KEY=

# Optional Notification Webhook
DEFAULT_SLACK_WEBHOOK_URL=
